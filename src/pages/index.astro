---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import HeroActions from "@/components/HeroActions";
import PhaseSlideDeck from "@/components/PhaseSlideDeck";
import CapabilitySlideDeck from "@/components/CapabilitySlideDeck";
import EngagementSlideDeck from "@/components/EngagementSlideDeck";
import { site } from "@/lib/site";
import { hero, trustVectors, about, contact, footer } from "@/lib/content";
---

<BaseLayout>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
  >
    Skip to main content
  </a>

  <div id="top"></div>
  <SiteHeader />

  <main id="main">
    <!-- Hero Section -->
    <section
      id="hero"
      class="border-line/60 relative overflow-hidden border-b bg-[radial-gradient(ellipse_70%_50%_at_50%_20%,var(--color-hero-glow)_0%,transparent_70%)] py-20 md:py-32"
    >
      <div class="stars" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <img
          class="hero-logo brand-logo mx-auto mb-8 w-[min(360px,75vw)]"
          src="/images/KRASIS.svg"
          alt={site.name}
          width="1500"
          height="265"
        />

        <div
          class="border-accent/30 bg-accent/10 mb-4 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-accent"
        >
          <span>{hero.headline}</span>
        </div>

        <h1
          class="mb-4 font-heading text-4xl font-extrabold tracking-tight text-heading sm:text-5xl lg:text-6xl"
        >
          {hero.subheadline}
        </h1>

        <p class="text-heading/90 mx-auto mb-6 max-w-2xl text-lg font-medium sm:text-xl">
          {hero.lead}
        </p>

        <p class="mx-auto mb-10 max-w-3xl text-base leading-relaxed text-body sm:text-lg">
          {hero.body}
        </p>

        <HeroActions client:load />

        <!-- Systems Architecture Showcase Visual -->
        <div
          class="bg-surface/50 hover:border-accent/50 relative mx-auto mt-14 max-w-4xl overflow-hidden rounded-2xl border border-line shadow-2xl transition-all duration-300"
        >
          <img
            src="/images/systems-architecture.jpg"
            alt="KRASIS Mission-Critical Systems Architecture & AI Verification"
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
            width="1920"
            height="1080"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"
          >
          </div>
          <div
            class="absolute bottom-4 left-4 right-4 flex items-center justify-between rounded-xl border border-white/20 bg-black/60 px-4 py-2.5 shadow-lg backdrop-blur-md"
          >
            <span class="font-mono text-xs font-semibold tracking-wider text-white">
              SYSTEM STATUS: MISSION CRITICAL // HARDWARE-VERIFIED
            </span>
            <span class="inline-flex items-center gap-1.5 font-mono text-xs text-emerald-400">
              <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
              ACTIVE
            </span>
          </div>
        </div>

        <!-- Trust Vectors -->
        <div
          class="border-line/60 mt-16 grid gap-5 border-t pt-12 text-left sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            trustVectors.map((item, idx) => (
              <div class="card-surface group">
                <div class="mb-3 flex items-center justify-between">
                  <span class="font-mono text-xs font-semibold text-accent">0{idx + 1}</span>
                  <div class="bg-accent/60 h-1.5 w-1.5 rounded-full group-hover:bg-accent" />
                </div>
                <h3 class="mb-2 text-base font-semibold text-heading">{item.title}</h3>
                <p class="text-sm leading-relaxed text-body">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="border-line/60 bg-surface/30 relative border-b py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <p class="kicker">{about.kicker}</p>
            <h2
              class="mb-4 font-heading text-3xl font-bold tracking-tight text-heading sm:text-4xl"
            >
              {about.title}
            </h2>
            <div class="accent-line" aria-hidden="true"></div>
            <p class="mb-4 text-base leading-relaxed text-body sm:text-lg">{about.intro}</p>
            <p class="text-base font-medium leading-relaxed text-heading sm:text-lg">
              {about.thesis}
            </p>
          </div>

          <div class="lg:col-span-5">
            <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-xl">
              <img
                src="/images/cyber-cloud.jpg"
                alt="Sovereign Cloud & Security Telemetry Center"
                class="aspect-[16/9] w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
                width="1920"
                height="1080"
              />
              <div class="border-line/60 border-t bg-surface p-4">
                <p class="font-mono text-xs font-semibold text-heading">
                  SOVEREIGN CLOUD OPERATIONS
                </p>
                <p class="mt-1 text-xs text-body">
                  Continuous zero-trust telemetry & human-audited deployment pipelines.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 4-Phase Interactive Presentation Slide Deck (iPod-Style) -->
        <PhaseSlideDeck client:visible />
      </div>
    </section>

    <!-- Capabilities Section -->
    <section id="capabilities" class="border-line/60 relative border-b py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="kicker">Capabilities</p>
            <h2
              class="mb-4 font-heading text-3xl font-bold tracking-tight text-heading sm:text-4xl"
            >
              What We Build
            </h2>
            <div class="accent-line" aria-hidden="true"></div>
            <p class="text-base leading-relaxed text-body sm:text-lg">
              Mission-critical systems engineered for extreme resilience, regulatory compliance, and
              verified zero-regression velocity.
            </p>
          </div>

          <div class="lg:col-span-4">
            <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-md">
              <img
                src="/images/embedded-hardware.jpg"
                alt="Multi-Layer PCB & Medical IoT Silicon"
                class="aspect-[16/9] w-full object-cover transition-transform duration-300 hover:scale-105"
                loading="lazy"
                width="1920"
                height="1080"
              />
              <div class="border-line/60 border-t bg-surface px-4 py-2.5">
                <p class="font-mono text-xs font-semibold text-heading">CUSTOM PCB & MEDICAL IoT</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Capabilities Interactive Presentation Slide Deck (iPod-Style) -->
        <CapabilitySlideDeck client:visible />
      </div>
    </section>

    <!-- Engagement Section -->
    <section id="engagement" class="border-line/60 bg-surface/30 relative border-b py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="kicker">Engagement</p>
          <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-heading sm:text-4xl">
            How We Work
          </h2>
          <div class="accent-line" aria-hidden="true"></div>
          <p class="text-base leading-relaxed text-body sm:text-lg">
            We partner with enterprise leadership, medical device manufacturers, and rapid-growth
            technology ventures through three defined engagement structures.
          </p>
        </div>

        <!-- Engagement Models Interactive Presentation Slide Deck (iPod-Style) -->
        <EngagementSlideDeck client:visible />
      </div>
    </section>

    <!-- Simple Contact Us Section -->
    <section id="contact" class="relative py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <p class="kicker">{contact.kicker}</p>
        <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-heading sm:text-4xl">
          {contact.title}
        </h2>
        <div class="mx-auto accent-line" aria-hidden="true"></div>
        <p class="mx-auto mb-12 max-w-2xl text-base leading-relaxed text-body sm:text-lg">
          {contact.body}
        </p>

        <!-- Direct Contact Cards: Email & Phone -->
        <div class="grid gap-6 text-left sm:grid-cols-2">
          <!-- Email Card -->
          <div class="card-surface group flex flex-col justify-between p-8">
            <div>
              <div
                class="border-accent/30 bg-accent/10 mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border text-accent"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-accent">
                Direct Email
              </p>
              <h3 class="mb-2 text-lg font-bold text-heading">Engineering & Scoping</h3>
              <p class="mb-6 text-sm text-body">
                Send your technical specs or inquiry directly to our lead engineering architects.
              </p>
            </div>
            <div>
              <a
                href={`mailto:${footer.engineeringEmail}`}
                class="btn-primary w-full text-center text-sm font-semibold"
              >
                {footer.engineeringEmail}
              </a>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="card-surface group flex flex-col justify-between p-8">
            <div>
              <div
                class="border-accent/30 bg-accent/10 mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border text-accent"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-accent">
                Direct Phone
              </p>
              <h3 class="mb-2 text-lg font-bold text-heading">Technical Consultation</h3>
              <p class="mb-6 text-sm text-body">
                Direct telephone line for executive consultation and active deployment scoping.
              </p>
            </div>
            <div>
              <a
                href={`tel:${footer.phoneRaw}`}
                class="btn-secondary w-full text-center text-sm font-semibold hover:border-accent hover:text-accent"
              >
                {footer.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Direct Contact Details -->
        <div class="bg-surface/50 mt-10 rounded-2xl border border-line p-5 text-xs text-body">
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            <span>
              <strong class="text-heading">Headquarters:</strong>
              {footer.location}
            </span>
            <span class="text-line">•</span>
            <span>{footer.privacy}</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Site Footer -->
  <footer class="bg-surface/50 border-t border-line py-12 text-sm text-body">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8"
    >
      <div class="flex items-center gap-3">
        <img
          class="brand-logo h-7 w-auto md:h-8"
          src="/images/KRASIS.svg"
          alt={site.name}
          width="1500"
          height="265"
        />
        <span class="text-xs text-body">&copy; 2026 {site.name}. All rights reserved.</span>
      </div>

      <nav
        class="flex flex-wrap items-center justify-center gap-6 text-xs"
        aria-label="Footer navigation"
      >
        <a href="#top" class="transition-colors hover:text-heading">Home</a>
        <a href="#about" class="transition-colors hover:text-heading">About Us</a>
        <a href="#capabilities" class="transition-colors hover:text-heading">Capabilities</a>
        <a href="#engagement" class="transition-colors hover:text-heading">How We Work</a>
        <a href="#contact" class="transition-colors hover:text-heading">Contact Us</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
