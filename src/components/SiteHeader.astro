---
import ThemeToggle from "@/components/ThemeToggle";
import { site } from "@/lib/site";
---

<header
  class="bg-canvas/85 sticky top-0 z-50 w-full border-b border-line backdrop-blur-md transition-colors"
  aria-label="Site navigation"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a
      href="#top"
      class="flex items-center gap-2 opacity-90 transition-opacity hover:opacity-100"
      aria-label="KRASIS Home"
    >
      <img
        class="brand-logo h-8 w-auto md:h-9"
        src="/images/KRASIS.svg"
        alt={site.name}
        width="1500"
        height="265"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-6 lg:flex xl:gap-10" aria-label="Main Navigation">
      <a
        href="#top"
        class="text-[15px] font-semibold text-body transition-colors hover:text-heading lg:text-base"
      >
        Home
      </a>
      <a
        href="#about"
        class="text-[15px] font-semibold text-body transition-colors hover:text-heading lg:text-base"
      >
        About Us
      </a>
      <a
        href="#capabilities"
        class="text-[15px] font-semibold text-body transition-colors hover:text-heading lg:text-base"
      >
        Capabilities
      </a>
      <a
        href="#engagement"
        class="text-[15px] font-semibold text-body transition-colors hover:text-heading lg:text-base"
      >
        How We Work
      </a>
      <a
        href="#contact"
        class="text-[15px] font-semibold text-body transition-colors hover:text-heading lg:text-base"
      >
        Contact Us
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3.5">
      <ThemeToggle client:load />
      <a
        href="#contact"
        class="btn-primary !px-5 !py-2.5 text-sm font-semibold tracking-wide sm:!px-6"
      >
        Contact Us
      </a>
    </div>
  </div>

  <!-- Mobile & Tablet Quick Nav Bar (< 1024px) -->
  <nav
    class="border-line/60 flex items-center justify-start sm:justify-center gap-3 overflow-x-auto no-scrollbar border-t px-4 py-2 text-xs font-semibold whitespace-nowrap lg:hidden"
    aria-label="Mobile Navigation"
  >
    <a href="#top" class="text-body transition-colors hover:text-heading px-1.5 py-0.5">Home</a>
    <span class="text-line opacity-50">•</span>
    <a href="#about" class="text-body transition-colors hover:text-heading px-1.5 py-0.5">About Us</a>
    <span class="text-line opacity-50">•</span>
    <a href="#capabilities" class="text-body transition-colors hover:text-heading px-1.5 py-0.5">Capabilities</a>
    <span class="text-line opacity-50">•</span>
    <a href="#engagement" class="text-body transition-colors hover:text-heading px-1.5 py-0.5">How We Work</a>
    <span class="text-line opacity-50">•</span>
    <a href="#contact" class="text-body transition-colors hover:text-heading px-1.5 py-0.5">Contact Us</a>
  </nav>
</header>
