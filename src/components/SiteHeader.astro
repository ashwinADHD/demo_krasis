---
import ThemeToggle from "@/components/ThemeToggle";
import { site } from "@/lib/site";
---

<header
  class="bg-canvas/85 sticky top-0 z-50 w-full border-b border-line backdrop-blur-md transition-colors"
  aria-label="Site navigation"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a
      href="#top"
      class="flex items-center gap-2 opacity-90 transition-opacity hover:opacity-100"
      aria-label="KRASIS Home"
    >
      <img
        class="brand-logo h-8 w-auto md:h-9"
        src="/images/KRASIS.svg"
        alt={site.name}
        width="1500"
        height="265"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-7 md:flex" aria-label="Main Navigation">
      <a href="#top" class="text-sm font-medium text-body transition-colors hover:text-heading">
        Home
      </a>
      <a href="#about" class="text-sm font-medium text-body transition-colors hover:text-heading">
        About Us
      </a>
      <a
        href="#capabilities"
        class="text-sm font-medium text-body transition-colors hover:text-heading"
      >
        Capabilities
      </a>
      <a
        href="#engagement"
        class="text-sm font-medium text-body transition-colors hover:text-heading"
      >
        How We Work
      </a>
      <a href="#contact" class="text-sm font-medium text-body transition-colors hover:text-heading">
        Contact Us
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <ThemeToggle client:load />
      <a
        href="#contact"
        class="btn-primary !px-4 !py-2 text-xs font-semibold sm:!px-5 sm:!py-2.5 sm:text-sm"
      >
        Contact Us
      </a>
    </div>
  </div>

  <!-- Mobile Quick Nav Bar -->
  <div
    class="border-line/60 flex items-center justify-center gap-4 border-t px-4 py-2 text-xs md:hidden"
  >
    <a href="#top" class="font-medium text-body transition-colors hover:text-heading">Home</a>
    <span class="text-line">•</span>
    <a href="#about" class="font-medium text-body transition-colors hover:text-heading">About Us</a>
    <span class="text-line">•</span>
    <a href="#capabilities" class="font-medium text-body transition-colors hover:text-heading"
      >Capabilities</a
    >
    <span class="text-line">•</span>
    <a href="#contact" class="font-medium text-body transition-colors hover:text-heading"
      >Contact Us</a
    >
  </div>
</header>
